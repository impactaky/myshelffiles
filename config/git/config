[diff]
tool = nvimdiff
[difftool "nvimdiff"]
cmd = "nvim -R -d -c \"wincmd l\" -d \"$LOCAL\" \"$REMOTE\""
[mergetool "nvimdiff"]
cmd = "nvim -d -c \"4wincmd w | wincmd J\" \"$LOCAL\" \"$BASE\" \"$REMOTE\"  \"$MERGED\""
[merge]
tool = nvimdiff
conflictstyle = diff3

[user]
email = impactaky@users.noreply.github.com
name = impactaky

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true

[filter "devcontainer"]
smudge = cat
clean = sed "/shelffiles/d"

[hook "lfs-post-checkout"]
	event = post-checkout
	command = git lfs post-checkout
[hook "lfs-post-commit"]
	event = post-commit
	command = git lfs post-commit
[hook "lfs-post-merge"]
	event = post-merge
	command = git lfs post-merge
[hook "lfs-pre-push"]
	event = pre-push
	command = git lfs pre-push
[core]
	pager = hunk pager
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
